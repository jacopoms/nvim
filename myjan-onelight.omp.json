{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "template": "<#ff79c6> {{ .Folder }}</> <p:yellow>❯</> ",
    "right_template": "{{ if .Executed }}<#6272a4> {{ .Segments.Executiontime.FormattedMs }}</>{{ end }}",
    "foreground": "#ffffff",
    "background": "transparent"
  },
  "secondary_prompt": {
    "template": "<p:yellow,transparent></><,p:yellow> > </><p:yellow,transparent></> ",
    "foreground": "#000000",
    "background": "transparent"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#fafafa",
          "background": "#4078f2",
          "type": "os",
          "style": "diamond"
        },
        {
          "options": {
            "folder_separator_icon": "  ",
            "home_icon": "~",
            "max_depth": 3,
            "style": "letter"
          },
          "template": "   {{ .Path }} ",
          "foreground": "#fafafa",
          "powerline_symbol": "",
          "background": "#a626a4",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "#383a42",
          "powerline_symbol": "",
          "background": "#c18401",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ]
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#fafafa",
          "powerline_symbol": "",
          "background": "#50a14f",
          "type": "node",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#383a42",
          "powerline_symbol": "",
          "background": "#0184bc",
          "type": "go",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "context",
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#383a42",
          "background": "#a626a4",
          "powerline_symbol": "",
          "type": "elixir",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#383a42",
          "powerline_symbol": "",
          "background": "#4078f2",
          "type": "julia",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#383a42",
          "powerline_symbol": "",
          "background": "#986801",
          "type": "python",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "always",
            "fetch_version": true
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#fafafa",
          "powerline_symbol": "",
          "background": "#ca1243",
          "type": "ruby",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_version": false
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#fafafa",
          "powerline_symbol": "",
          "background": "#c18401",
          "type": "azfunc",
          "style": "powerline"
        },
        {
          "options": {
            "display_default": false
          },
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "foreground": "#fafafa",
          "powerline_symbol": "",
          "type": "aws",
          "style": "powerline",
          "background_templates": [
            "{{if contains \"default\" .Profile}}#FFA400{{end}}",
            "{{if contains \"jan\" .Profile}}#f1184c{{end}}"
          ]
        },
        {
          "template": "  ",
          "foreground": "#383a42",
          "powerline_symbol": "",
          "background": "#986801",
          "type": "root",
          "style": "powerline"
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "type": "executiontime",
          "style": "plain",
          "foreground": "#383a42",
          "background": "#fafafa",
          "template": "<#f8f8f2,transparent></>  {{ .FormattedMs }} <transparent,#f8f8f2></>"
        },
        {
          "options": {
            "always_enabled": true
          },
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "",
          "invert_powerline": true,
          "foreground": "#fafafa",
          "background": "#50a14f",
          "background_templates": ["{{ if gt .Code 0 }}#ff5555{{ end }}"],
          "template": "  {{ if gt .Code 0 }}{{ reason .Code }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "template": "❯ ",
          "foreground": "#383a42",
          "background": "transparent",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "tooltips": [
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
      "foreground": "#fafafa",
      "background": "#ffa500",
      "type": "aws",
      "style": "diamond",
      "tips": ["aws"]
    },
    {
      "options": {
        "display_default": true
      },
      "leading_diamond": "",
      "trailing_diamond": "",
      "template": "  {{ .Name }} ",
      "foreground": "p:white",
      "background": "p:blue",
      "type": "az",
      "style": "diamond",
      "tips": ["az"]
    }
  ],
  "version": 4,
  "final_space": true
}
